[Unit]
Description=Wizard Vision guarded programming curriculum
After=network-online.target srv-wizard.mount
Wants=network-online.target
RequiresMountsFor=/srv/wizard
StartLimitIntervalSec=0

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/srv/wizard/project
ExecStart=/bin/bash /srv/wizard/project/scripts/aws/run_programming_curriculum_service.sh
ExecStop=/bin/bash /srv/wizard/project/scripts/aws/stop_programming_curriculum_service.sh
Restart=on-failure
RestartSec=10
# Exit 42 means one replay was behaviorally rejected and its final-brain
# transaction was rolled back. Preserve that evidence for a code/data fix
# instead of retraining and rejecting the same interval in a restart loop.
#
# Exit 90 means deferred replay stopped at a durable boundary below
# `--min-free-disk-gb` AND the rollback that normally reclaims this volume
# returned nothing either. The `.wbrain` store is append-only, so a restart
# burns the remaining headroom and stops again at the same place; only a larger
# volume or a compaction changes the outcome.
#
# (Until 2026-09-15 this branch was reached without ever attempting that
# rollback, so a volume holding 414 GB of reclaimable blocks halted terminally
# and the unit sat `failed` for 107.7 h. The supervisor now rolls back first and
# only exits 90 if the volume is still below its floor afterwards.)
#
# Exit 91 means the volume is FINE and no unresolved interval can reach its gate
# inside the window a rollback buys -- measured 2026-09-15 at 3.64 h against a
# shortest ETA of 29.34 h, 0 of 22 fitting. Restarting cannot change that: the
# work unit is too large for the host's burn, so a respawn spends one rollback
# per interval to rediscover it. Deliberately distinct from 90, because the
# operator response is different -- 90 says resize or compact, 91 says the
# corpus intervals must be split or the burn reduced.
RestartPreventExitStatus=42 90 91
# Automatic quarantine recovery may replace the original brain server with a
# verified child process. Keep that recovered node alive across supervisor
# restarts so the next invocation can attach to its endpoint.
KillMode=process
TimeoutStopSec=120
StandardOutput=append:/srv/wizard/runtime/programming-integrated-20260713/curriculum-service.stdout.log
StandardError=append:/srv/wizard/runtime/programming-integrated-20260713/curriculum-service.stderr.log

[Install]
WantedBy=multi-user.target
